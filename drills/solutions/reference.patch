+def ask_user(ctx: ToolContext, question: str) -> ToolOutput:
+    """End the turn with a clarifying question instead of guessing."""
+    return ToolOutput("Question shown to the user.", final_message=question)
+
+
+def get_table_schema(ctx: ToolContext, table: str) -> ToolOutput:
+    tables = introspect(ctx.conn, ctx.settings.description_dir)
+    match = [t for t in tables if t.name.lower() == table.strip().strip('"').lower()]
+    if not match:
+        return ToolOutput(f"No table '{table}'. Tables: {', '.join(t.name for t in tables)}.")
+    return ToolOutput(render_schema(match))
+
+
+def _words(text: str) -> set[str]:
+    return set(re.findall(r"[a-z0-9]+", text.lower()))
+
+
+def find_similar_queries(ctx: ToolContext, question: str) -> ToolOutput:
+    path = Path(ctx.settings.examples_path)
+    if not path.exists():
+        return ToolOutput("No verified queries available. Write the SQL yourself.")
+    pairs = json.loads(path.read_text())
+    words = _words(question)
+    scored = sorted(pairs, key=lambda p: len(words & _words(p["question"])), reverse=True)[:3]
+    lines = [f"Q: {p['question']}\nSQL: {p['sql']}" for p in scored if words & _words(p["question"])]
+    if not lines:
+        return ToolOutput("No similar verified queries. Write the SQL yourself.")
+    return ToolOutput("Verified queries, most similar first (adapt, don't copy blindly):\n\n" + "\n\n".join(lines))
+
+
+def search_glossary(ctx: ToolContext, term: str) -> ToolOutput:
+    needle = term.lower().strip()
+    hits = [
+        f"{table}.{column}: {doc}"
+        for table, columns in load_descriptions(ctx.settings.description_dir).items()
+        for column, doc in columns.items()
+        if needle and (needle in column.lower() or needle in doc.lower())
+    ]
+    return ToolOutput("\n".join(hits[:20]) if hits else f"No documentation mentions '{term}'.")
+
+
