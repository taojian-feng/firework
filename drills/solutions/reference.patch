diff --git a/src/loadtest.py b/src/loadtest.py
new file mode 100644
index 0000000..c46cd2a
--- /dev/null
+++ b/src/loadtest.py
@@ -0,0 +1,97 @@
+"""Load test: N concurrent users asking dev questions for a fixed time (closed loop).
+
+    uv run loadtest --concurrency 1,4,8 --duration 60 --model accounts/fireworks/models/gpt-oss-120b
+
+Each worker owns its own SQLAgent (and so its own SQLite connection and history). The report per
+concurrency level is what Raul's 30k queries/day target needs: throughput, P50/P95 latency,
+error rate, and LLM calls / tokens per question (the cost drivers).
+"""
+
+import argparse
+import json
+import random
+import threading
+import time
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+from typing import Callable
+
+from src.agent import SQLAgent
+from src.config import Settings
+from src.evaluate import percentile
+
+
+def _worker(make_agent: Callable[[], SQLAgent], questions: list[dict], stop_at: float, rows: list, lock) -> None:
+    agent = make_agent()
+    while time.perf_counter() < stop_at:
+        question = random.choice(questions)
+        agent.reset()
+        t0 = time.perf_counter()
+        out = agent.ask(question["question"])
+        row = dict(
+            latency_s=time.perf_counter() - t0,
+            ok=out.ok,
+            llm_calls=out.llm_calls,
+            tokens=out.prompt_tokens + out.completion_tokens,
+            error="" if out.ok else out.message[:120],
+        )
+        with lock:
+            rows.append(row)
+
+
+def run_load(make_agent: Callable[[], SQLAgent], questions: list[dict], concurrency: int, duration_s: float) -> dict:
+    rows: list[dict] = []
+    lock = threading.Lock()
+    start = time.perf_counter()
+    stop_at = start + duration_s
+    with ThreadPoolExecutor(max_workers=concurrency) as pool:
+        for _ in range(concurrency):
+            pool.submit(_worker, make_agent, questions, stop_at, rows, lock)
+    elapsed = time.perf_counter() - start  # includes the tail of in-flight requests
+    latencies = [r["latency_s"] for r in rows]
+    n = len(rows) or 1
+    return dict(
+        concurrency=concurrency,
+        requests=len(rows),
+        qps=round(len(rows) / elapsed, 2),
+        p50_s=round(percentile(latencies, 50), 2) if rows else 0.0,
+        p95_s=round(percentile(latencies, 95), 2) if rows else 0.0,
+        error_rate=round(sum(not r["ok"] for r in rows) / n, 3),
+        avg_llm_calls=round(sum(r["llm_calls"] for r in rows) / n, 2),
+        avg_tokens=round(sum(r["tokens"] for r in rows) / n),
+        errors=sorted({r["error"] for r in rows if r["error"]})[:5],
+    )
+
+
+def main(argv: list[str] | None = None) -> None:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--concurrency", default="1,4,8", help="comma-separated levels")
+    parser.add_argument("--duration", type=float, default=60.0, help="seconds per level")
+    parser.add_argument("--model", default=None)
+    parser.add_argument("--questions", default="data/dev_questions.json")
+    args = parser.parse_args(argv)
+
+    settings = Settings()
+    if args.model:
+        settings.model = args.model
+    questions = json.loads(Path(args.questions).read_text())
+    reports = []
+    print(f"model={settings.model}")
+    print(f"{'users':>5} {'reqs':>5} {'qps':>6} {'p50_s':>6} {'p95_s':>6} {'err%':>5} {'calls':>5} {'tokens':>7}")
+    for level in [int(x) for x in args.concurrency.split(",")]:
+        r = run_load(lambda: SQLAgent(settings), questions, level, args.duration)
+        reports.append(r)
+        print(
+            f"{r['concurrency']:>5} {r['requests']:>5} {r['qps']:>6} {r['p50_s']:>6} {r['p95_s']:>6} "
+            f"{100 * r['error_rate']:>5.1f} {r['avg_llm_calls']:>5} {r['avg_tokens']:>7}"
+        )
+        for e in r["errors"]:
+            print(f"      error: {e}")
+    out = Path("results") / f"load_{settings.model.rsplit('/', 1)[-1]}.json"
+    out.parent.mkdir(exist_ok=True)
+    out.write_text(json.dumps(dict(model=settings.model, levels=reports), indent=2))
+    print(f"saved {out}")
+
+
+if __name__ == "__main__":
+    main()
